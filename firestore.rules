rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só a família pode ler e escrever. Troque pelos vossos emails Google.
    function familia() {
      return request.auth != null
        && request.auth.token.email in [
          "tabletdaniel1995@gmail.com",
          "susanaisalmeida1996@gmail.com",
          "monimecarregosa@gmail.com"
        ];
    }
    match /{document=**} {
      allow read, write: if familia();
    }
  }
}
